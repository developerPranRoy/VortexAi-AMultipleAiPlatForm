# Server
PORT=10000

# MongoDB Atlas connection string
MONGODB_URL=mongodb+srv://<user>:<password>@cluster.mongodb.net/agent

# Redis (from Render Redis add-on or Upstash)
REDIS_URL=redis://...

# Chat service internal URL (set to your deployed vortexai-chat URL)
CHAT_SERVICE=https://vortexai-chat.onrender.com

# AI API Keys
GROQ_API_KEY=gsk_...
GOOGLE_API_KEY=...
OPENROUTER_API_KEY=sk-or-v1-...
TAVILY_API_KEY=tvly-...

# Cloudinary (for image/PDF/PPT uploads)
CLOUDINARY_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
